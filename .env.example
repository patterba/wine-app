# Database
DATABASE_URL="postgresql://user:password@localhost:5432/wine_tourism_db?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here-generate-with-openssl-rand-base64-32"

# Auth Providers (Optional - for social login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email (Resend or Postmark)
RESEND_API_KEY=""
# OR
POSTMARK_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"

# AWS S3 or Cloudflare R2 (for image uploads)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""

# Google Maps API (for location features)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Wine Tourism Platform"

# Feature Flags
NEXT_PUBLIC_ENABLE_SOCIAL_LOGIN="false"
NEXT_PUBLIC_ENABLE_PREMIUM_LISTINGS="false"

# Commission Rate (in percentage)
PLATFORM_COMMISSION_RATE="4"
PREMIUM_LISTING_FEE_CENTS="500"
