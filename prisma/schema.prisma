// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  WINERY_OWNER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?
  role          UserRole  @default(USER)
  emailVerified DateTime?
  image         String?

  accounts      Account[]
  sessions      Session[]
  bookings      Booking[]
  wineries      Winery[]
  wineClubMemberships WineClubMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Region {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  imageUrl    String?
  state       String

  wineries    Winery[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("regions")
}

model Winery {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  description      String?   @db.Text
  address          String
  city             String
  state            String
  zipCode          String
  latitude         Float?
  longitude        Float?
  phone            String?
  email            String
  website          String?

  regionId         String
  region           Region    @relation(fields: [regionId], references: [id])

  ownerId          String
  owner            User      @relation(fields: [ownerId], references: [id])

  stripeAccountId  String?   @unique
  isActive         Boolean   @default(true)
  isFeatured       Boolean   @default(false)

  tastingExperiences TastingExperience[]
  bookings         Booking[]
  operatingHours   OperatingHours[]
  capacitySettings CapacitySetting?
  images           WineryImage[]
  wineClubs        WineClub[]

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([regionId])
  @@index([slug])
  @@map("wineries")
}

model WineryImage {
  id          String   @id @default(cuid())
  wineryId    String
  winery      Winery   @relation(fields: [wineryId], references: [id], onDelete: Cascade)
  url         String
  altText     String?
  isPrimary   Boolean  @default(false)
  order       Int      @default(0)

  createdAt   DateTime @default(now())

  @@index([wineryId])
  @@map("winery_images")
}

model TastingExperience {
  id              String    @id @default(cuid())
  wineryId        String
  winery          Winery    @relation(fields: [wineryId], references: [id], onDelete: Cascade)

  name            String
  description     String?   @db.Text
  priceInCents    Int
  durationMinutes Int
  maxPartySize    Int       @default(8)
  minPartySize    Int       @default(1)
  isActive        Boolean   @default(true)

  bookings        Booking[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([wineryId])
  @@map("tasting_experiences")
}

model Booking {
  id                    String        @id @default(cuid())

  userId                String
  user                  User          @relation(fields: [userId], references: [id])

  wineryId              String
  winery                Winery        @relation(fields: [wineryId], references: [id])

  tastingExperienceId   String
  tastingExperience     TastingExperience @relation(fields: [tastingExperienceId], references: [id])

  bookingDate           DateTime
  startTime             String        // Format: "HH:MM"
  partySize             Int

  status                BookingStatus @default(PENDING)

  totalAmountCents      Int
  platformFeeCents      Int

  stripePaymentIntentId String?       @unique

  specialRequests       String?       @db.Text
  checkedInAt           DateTime?

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([userId])
  @@index([wineryId])
  @@index([bookingDate])
  @@index([status])
  @@map("bookings")
}

model OperatingHours {
  id         String   @id @default(cuid())
  wineryId   String
  winery     Winery   @relation(fields: [wineryId], references: [id], onDelete: Cascade)

  dayOfWeek  Int      // 0 = Sunday, 6 = Saturday
  openTime   String   // Format: "HH:MM"
  closeTime  String   // Format: "HH:MM"
  isClosed   Boolean  @default(false)

  @@unique([wineryId, dayOfWeek])
  @@index([wineryId])
  @@map("operating_hours")
}

model CapacitySetting {
  id                   String   @id @default(cuid())
  wineryId             String   @unique
  winery               Winery   @relation(fields: [wineryId], references: [id], onDelete: Cascade)

  maxGuestsPerSlot     Int      @default(20)
  slotIntervalMinutes  Int      @default(30)
  bufferMinutes        Int      @default(15)
  advanceBookingDays   Int      @default(90)
  minimumAdvanceHours  Int      @default(2)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("capacity_settings")
}

// Wine Club Management Models

enum MembershipStatus {
  ACTIVE
  PAUSED
  CANCELLED
  PAST_DUE
}

enum ShipmentStatus {
  SCHEDULED
  PROCESSING
  SHIPPED
  DELIVERED
  SKIPPED
}

enum BillingFrequency {
  MONTHLY
  QUARTERLY
  BIANNUAL
  ANNUAL
}

model WineClub {
  id          String   @id @default(cuid())
  wineryId    String
  winery      Winery   @relation(fields: [wineryId], references: [id], onDelete: Cascade)

  name        String
  description String?  @db.Text
  isActive    Boolean  @default(true)

  tiers       MembershipTier[]
  memberships WineClubMembership[]
  shipments   Shipment[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([wineryId])
  @@map("wine_clubs")
}

model MembershipTier {
  id              String   @id @default(cuid())
  wineClubId      String
  wineClub        WineClub @relation(fields: [wineClubId], references: [id], onDelete: Cascade)

  name            String   // e.g., "Silver", "Gold", "Platinum"
  description     String?  @db.Text
  priceInCents    Int      // Per billing period
  billingFrequency BillingFrequency
  bottlesPerShipment Int   @default(3)
  shipmentsPerYear   Int   @default(4)
  discountPercent    Int   @default(0)

  isActive        Boolean  @default(true)
  order           Int      @default(0)

  memberships     WineClubMembership[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([wineClubId])
  @@map("membership_tiers")
}

model WineClubMembership {
  id                    String           @id @default(cuid())

  userId                String
  user                  User             @relation(fields: [userId], references: [id])

  wineClubId            String
  wineClub              WineClub         @relation(fields: [wineClubId], references: [id])

  tierId                String
  tier                  MembershipTier   @relation(fields: [tierId], references: [id])

  status                MembershipStatus @default(ACTIVE)

  // Stripe subscription
  stripeSubscriptionId  String?          @unique
  stripeCustomerId      String?

  // Shipping info
  shippingName          String
  shippingAddress       String
  shippingCity          String
  shippingState         String
  shippingZipCode       String
  shippingPhone         String?

  // Membership dates
  startDate             DateTime         @default(now())
  nextBillingDate       DateTime?
  pausedUntil           DateTime?
  cancelledAt           DateTime?
  cancellationReason    String?          @db.Text

  // Referrals
  referredBy            String?          // User ID who referred them
  referralCode          String?          @unique

  shipments             ShipmentMembership[]

  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([userId])
  @@index([wineClubId])
  @@index([status])
  @@map("wine_club_memberships")
}

model Shipment {
  id                String   @id @default(cuid())
  wineClubId        String
  wineClub          WineClub @relation(fields: [wineClubId], references: [id])

  name              String   // e.g., "Spring 2025 Release"
  scheduledDate     DateTime

  description       String?  @db.Text
  status            ShipmentStatus @default(SCHEDULED)

  members           ShipmentMembership[]
  items             ShipmentItem[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([wineClubId])
  @@index([scheduledDate])
  @@map("shipments")
}

model ShipmentMembership {
  id                  String   @id @default(cuid())

  shipmentId          String
  shipment            Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  membershipId        String
  membership          WineClubMembership @relation(fields: [membershipId], references: [id])

  status              ShipmentStatus @default(SCHEDULED)
  isSkipped           Boolean  @default(false)
  skippedReason       String?

  // Tracking
  trackingNumber      String?
  carrier             String?
  shippedDate         DateTime?
  deliveredDate       DateTime?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([shipmentId, membershipId])
  @@index([membershipId])
  @@map("shipment_memberships")
}

model ShipmentItem {
  id          String   @id @default(cuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  wineName    String
  vintage     String?
  varietal    String?
  quantity    Int      @default(1)

  bottleImageUrl String?
  description    String? @db.Text

  @@index([shipmentId])
  @@map("shipment_items")
}
